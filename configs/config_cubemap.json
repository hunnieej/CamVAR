{
  "_comment": "Cubemap anchor-weighted training — 1 GPU. Modeled on config_phase_c.json.",

  "exp_name": "cubemap_anchor_1gpu",
  "wandb_project": "STAR-T2I-CubemapTraining",
  "wandb_run_name": "cubemap_anchor_1gpu",
  "wandb_mode": "online",

  "_comment_dataset": "=== CUBEMAP DATASET (on-the-fly ERP → 6 faces) ===",
  "dataset_type": "cubemap",
  "cubemap_erp_jsonl_paths": [
    "dataset/ERP/matterport.jsonl",
    "dataset/ERP/polyhaven.jsonl"
  ],
  "cubemap_erp_jsonl_paths_val": [
    "dataset/ERP/matterport.jsonl"
  ],
  "cubemap_fov_deg": 90.0,

  "_comment_grouping": "=== 2-SET ANCHOR-WEIGHTED GROUPING ===",
  "_comment_set1": "set1 = [front, back, left, right] — horizontal belt",
  "_comment_set2": "set2 = [front, back, up, down]   — vertical cross",
  "_comment_anchor": "front and back appear in BOTH sets: intentional anchor weighting",
  "cubemap_canonical_face_order": ["front", "right", "back", "left", "up", "down"],
  "cubemap_set1_faces": ["front", "back", "left", "right"],
  "cubemap_set2_faces": ["front", "back", "up", "down"],
  "cubemap_anchor_weighted": true,
  "cubemap_total_slots_per_update": 8,

  "_comment_conditioning": "=== CUBEMAP CONDITIONING ===",
  "cubemap_conditioning_mode": "face_id",
  "cubemap_face_id_embed_dim": 3,

  "_comment_output_flags": "=== OUTPUT FLAGS ===",
  "cubemap_erp_reconstruction": true,
  "cubemap_debug": false,

  "_comment_training": "=== TRAINING CONFIGURATION (matches config_phase_c.json) ===",
  "depth": 30,
  "bs": 4,
  "batch_size": 0,
  "glb_batch_size": 0,
  "ac": 1,
  "ep": 10,
  "adapter_metrics_every": 100,
  "infer_bsz": 1,
  "ckpt_save_it": 500,

  "_comment_ray": "=== RAY ADAPTATION PARAMETERS (matches config_phase_c.json) ===",
  "enable_ray_adaptation": true,
  "ray_patch_nums": [1, 2, 3, 4, 6, 9, 13, 18, 24, 32],
  "adapter_dim": 128,
  "num_memory_tokens": 32,
  "ray_adapter_num_heads": 4,
  "ray_adapter_head_dim": 32,
  "adapter_active_scale_indices": [0, 1, 2, 3],
  "warm_start_steps": 1000,
  "warm_theta_gain_value": 12.0,
  "warm_temp_gain_value": 8.0,
  "warm_unfreeze": true,
  "theta_gain_value": 8.0,
  "temp_gain_value": 6.0,
  "gate_floor": 0.0,
  "gate_max": 0.1,
  "gate_init": 0.03,
  "gate_temperature": 1.0,
  "disable_memory_kv": false,
  "theta_log_every": 100,
  "fov_deg": 90.0,
  "patch_size_ray": 16,

  "_comment_ckpt": "=== CHECKPOINT / OUTPUT PATHS ===",
  "ckpt_path": "ckpt",
  "pretrained_ckpt": "ckpt/star_rope_d30_512-ar-ckpt-ep1-iter30000.pth",
  "text_enc": "clip",
  "text_enc_path": "ckpt/CLIP",
  "local_out_dir_path": "outputs/cubemap_anchor_1gpu",
  "instance_prompt": "dataset/prompts/val_scenes_c.txt",

  "_comment_arch": "=== MODEL / DATA ARCHITECTURE ===",
  "pn": "1_2_3_4_6_9_13_18_24_32",
  "patch_size": 16,
  "patch_nums": [1, 2, 3, 4, 6, 9, 13, 18, 24, 32],
  "data_load_reso": 512,
  "mid_reso": 1.125,
  "classifier_free_training_prob": 0.1,
  "hflip": false,
  "workers": 0,

  "_comment_opt": "=== OPTIMIZER / LR SCHEDULE ===",
  "fp16": 1,
  "tlr": 1e-4,
  "tblr": 0.0001,
  "twd": 0.05,
  "twde": 0,
  "tclip": 2.0,
  "ls": 0.0,
  "wp": 0,
  "wp0": 0.005,
  "wpe": 0.01,
  "sche": "lin0",
  "opt": "adamw",

  "_comment_model": "=== MODEL FLAGS ===",
  "rope_emb": true,
  "lvl_emb": true,
  "rope_norm": 64,
  "rope_theta": 10000.0,
  "logit_norm": true,
  "enable_cross": true,
  "enable_fig_val": true,
  "enable_discard": false,
  "from_scratch": false,
  "from_0": true,
  "using_webtar": false,

  "_comment_misc": "=== MISC ===",
  "tf32": true,
  "device": "cuda",
  "default_label": 1000,
  "seed": 42,
  "same_seed_for_all_ranks": 0,
  "cfg": 4.0,

  "vfast": 0,
  "tfast": 0,
  "ini": -1,
  "hd": 0.02,
  "aln": 0.5,
  "alng": 5e-5,
  "afuse": true,
  "saln": false,
  "anorm": true,
  "fuse": false,
  "pg": 0.0,
  "pg0": 4,
  "pgwp": 0,
  "drop_scale_length": null,
  "resos": null
}
